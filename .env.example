# --- Contact form delivery (Resend) -----------------------------------------
# All server-side. Never prefix with NEXT_PUBLIC_ — that would inline the value
# into the client bundle where anyone can read it.
#
# Set in Vercel with printf, never echo — a trailing newline breaks the auth header:
#   printf 're_xxxxxxxx' | npx vercel env add RESEND_API_KEY production
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, or delivery 403s.
CONTACT_FROM_EMAIL=website@meyng.com

# Where leads land. Defaults to contact@meyng.com if unset.
CONTACT_TO_EMAIL=contact@meyng.com

# Test-only seam: point delivery at a local stub. Leave unset in every real env.
# RESEND_API_BASE=http://127.0.0.1:4001

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
