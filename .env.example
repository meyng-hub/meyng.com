# Server-side contact form delivery endpoint (NOT NEXT_PUBLIC_ — must stay out of
# the client bundle so bots can't POST to the provider directly).
# Set in Vercel with printf, never echo — a trailing newline yields a silent 404:
#   printf 'https://formspree.io/f/XXXXXXXX' | npx vercel env add CONTACT_FORM_ENDPOINT production
CONTACT_FORM_ENDPOINT=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=
